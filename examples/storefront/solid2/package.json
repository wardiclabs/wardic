    "smoke": "vite build && bun ../shared/src/smoke.ts solid2"
  },
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.4",
    "@solidjs/router": "2.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.20",
    "@wardic/core": "workspace:*",
    "@wardic/dom": "workspace:*",
    "@wardic/example-storefront-shared": "workspace:*",
    "@wardic/solid": "workspace:*",
    "effect": "4.1.1",
    "shiki": "4.3.1",
    "solid-js": "2.0.0-rc.20"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.54",
    "filesystem-routing": "0.4.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24"
  }
