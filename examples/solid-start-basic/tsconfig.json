{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["@wardic/source"],
    // The @wardic/* packages ship TS source whose relative imports carry `.ts`
    // extensions (Effect v4 convention). Vite resolves them; tsc needs this flag.
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vinxi/types/client"],
    // The app's own Solid 1 for every importer, the binding's sources among them: @wardic/solid's
    // own `solid-js` is Solid 2 (#566).
    "paths": {
      "~/*": ["./src/*"],
      "solid-js": ["./node_modules/solid-js/types/index.d.ts"],
      "solid-js/web": ["./node_modules/solid-js/web/types/index.d.ts"],
      "solid-js/store": ["./node_modules/solid-js/store/types/index.d.ts"],
      "solid-js/jsx-runtime": ["./node_modules/solid-js/types/jsx.d.ts"]
    }
  }
}
