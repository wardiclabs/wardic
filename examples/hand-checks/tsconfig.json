{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["@wardic/source"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    // `import.meta.env.DEV` in the reports: the examples build them with Vite.
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}
