{
  // Standalone on purpose, as layout-lab's: not extending tsconfig.base.json, not composite, and not in
  // the root tsconfig.json's references. Vite builds it; `bun run typecheck` checks it here, on Solid 2:
  // `solid-js` and `@solidjs/web` map to packages/solid's, as vite.config.ts resolves them.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["@wardic/source"],
    // The @wardic/* packages ship TS source whose relative imports carry `.ts` extensions.
    "allowImportingTsExtensions": true,
    "paths": {
      "solid-js": ["../../packages/solid/node_modules/solid-js/types/index.d.ts"],
      "@solidjs/web": ["../../packages/solid/node_modules/@solidjs/web/types/index.d.ts"],
      "@solidjs/web/jsx-runtime": ["../../packages/solid/node_modules/@solidjs/web/types/jsx.d.ts"],
      "@solidjs/web/jsx-dev-runtime": ["../../packages/solid/node_modules/@solidjs/web/types/jsx.d.ts"]
    },
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"]
  },
  // Solid's Babel plugins' types, for vite.solid2.ts, as foldkit's tests take them.
  "include": ["src", "test", "vite.config.ts", "vitest.browser.config.ts", "../../packages/solid/babel-modules.d.ts"]
}
