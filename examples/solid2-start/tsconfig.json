{
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["@wardic/source"],
    // The @wardic packages ship TS source whose relative imports carry `.ts` extensions.
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node", "@solidjs/vite-plugin/virtual-modules"],
    // @wardic/solid's source imports `solid-js`, which from packages/solid is that package's own copy:
    // map every importer's to this app's Solid 2, so the binding and the app share one (#566).
    "paths": { "solid-js": ["./node_modules/solid-js/types/index.d.ts"] }
  },
  "include": ["src", "file-routes.d.ts"]
}
