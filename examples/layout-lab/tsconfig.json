{
  // Standalone on purpose: NOT extending tsconfig.base.json, NOT composite, and NOT
  // listed in the root tsconfig.json references. The lab is bundler-built (Vite)
  // and typechecked on its own via `bun run typecheck` in this package, on Solid 1
  // here and on Solid 2 by tsconfig.v2.json (#209 PR 5).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["@wardic/source"],
    // The @wardic/* packages ship TS source whose relative imports carry `.ts`
    // extensions (Effect v4 convention). Vite resolves them; tsc needs this flag.
    "allowImportingTsExtensions": true,
    // The lab's own Solid 1 for every importer, the binding's sources among them: @wardic/solid's
    // own `solid-js` is Solid 2 (#566).
    "paths": {
      "solid-js": ["./node_modules/solid-js/types/index.d.ts"],
      "solid-js/web": ["./node_modules/solid-js/web/types/index.d.ts"],
      "solid-js/store": ["./node_modules/solid-js/store/types/index.d.ts"],
      "solid-js/jsx-runtime": ["./node_modules/solid-js/types/jsx.d.ts"]
    },
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"]
  },
  "include": ["src", "test", "vite.config.ts", "vite.save-log.ts", "vitest.browser.config.ts"],
  // The Solid 2 build's own (tsconfig.v2.json).
  "exclude": ["src/scenarios-v2", "src/binding/solid2.ts"]
}
