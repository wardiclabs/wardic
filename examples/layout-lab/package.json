{
  "name": "@wardic/example-layout-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Client-only Vite + Solid lab measuring whether each layout-trigger path paints the destination box before Wardic's measure pass (issue #2). Built on Solid 1 (`dev`) or on Solid 2 with @wardic/solid/unstable/v2 (`dev:v2`).",
  "imports": {
    "#binding": {
      "solid2": "./src/binding/solid2.ts",
      "default": "./src/binding/solid1.ts"
    },
    "#scenarios": {
      "solid2": "./src/scenarios-v2/index.ts",
      "default": "./src/scenarios/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:v2": "vite --config vite.v2.config.ts",
    "build": "vite build",
    "build:v2": "vite build --config vite.v2.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.v2.json"
  },
  "dependencies": {
    "@wardic/core": "workspace:*",
    "@wardic/dom": "workspace:*",
    "@wardic/solid": "workspace:*",
    "effect": "4.0.5",
    "solid-js": "1.9.13"
  },
  "devDependencies": {
    "vite": "6.4.2",
    "vite-plugin-solid": "2.11.12"
  }
}
