{
  "name": "wardic",
  "private": true,
  "type": "module",
  "description": "A reactive, services-based animation engine built on Effect v4.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build && bun run --filter='@wardic/*' typecheck:tests",
    "typecheck:tests": "bun run --filter='@wardic/*' typecheck:tests",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint": "eslint packages/core/src packages/core/bench packages/dom packages/solid packages/test",
    "bench:core": "bun packages/core/bench/run.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "overrides": {
    "playwright": "1.59.1",
    "playwright-core": "1.59.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/vitest": "4.0.2",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^25.7.0",
    "@vitest/browser-playwright": "^5.0.2",
    "effect": "4.0.2",
    "eslint": "^10.12.0",
    "happy-dom": "^20.10.1",
    "jsdom": "^29.1.1",
    "playwright": "1.59.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "6.4.2",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^5.0.2"
  }
}
