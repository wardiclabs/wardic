{
  "name": "wardic",
  "private": true,
  "type": "module",
  "description": "A reactive, services-based animation engine built on Effect v4.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*",
    "examples/storefront/*",
    "site"
  ],
  "scripts": {
    "build": "bun scripts/build-packages.ts",
    "pack:check": "bun scripts/pack-check/run.ts",
    "typecheck": "node_modules/typescript-7/bin/tsc --build && bun run --filter='@wardic/*' typecheck:tests && bun run --filter='@wardic/example-*' --filter='@wardic/site' typecheck",
    "typecheck:tests": "bun run --filter='@wardic/*' typecheck:tests",
    "clean": "node_modules/typescript-7/bin/tsc --build --clean && rm -rf packages/*/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:storefront": "bun run --filter='@wardic/example-storefront-solid*' --filter='@wardic/example-storefront-next' smoke",
    "lint": "eslint packages/core/src packages/core/bench packages/core/test packages/dom packages/solid packages/test",
    "bench:core": "bun packages/core/bench/run.ts",
    "bench:solid": "bun packages/solid/bench/run.ts",
    "bench:motion": "bun packages/solid/bench/motion/run.ts",
    "size": "bun packages/solid/bench/size.ts",
    "skills": "bun scripts/sync-agent-skills.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun scripts/sync-versions.ts",
    "release": "bun run build && bun scripts/publish-packages.ts"
  },
  "overrides": {
    "playwright": "1.59.1",
    "playwright-core": "1.59.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.0",
    "@effect/vitest": "4.1.4",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^25.7.0",
    "@vitest/browser-playwright": "^5.0.2",
    "effect": "4.1.4",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "happy-dom": "^20.10.1",
    "jsdom": "^29.1.1",
    "playwright": "1.59.1",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "6.4.2",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.0.2"
  },
  "patchedDependencies": {
    "@kobalte/core@2.0.0-alpha.4": "patches/@kobalte%2Fcore@2.0.0-alpha.4.patch"
  }
}
