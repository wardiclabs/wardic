{
  "name": "@wardic/dom",
  "version": "0.1.0-alpha.0",
  "description": "Browser environment Layers for Wardic \u2014 rAF clock, DOM renderer, input, probe, interpolators.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@wardic/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "@wardic/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./internal/*": null
  },
  "scripts": {
    "build": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck:tests": "../../node_modules/typescript-7/bin/tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@wardic/core": "workspace:*",
    "culori": "^4.0.2"
  },
  "peerDependencies": {
    "effect": "^4.1.1"
  },
  "devDependencies": {
    "@wardic/test": "workspace:*"
  }
}
