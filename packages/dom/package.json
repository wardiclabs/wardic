{
  "name": "@wardic/dom",
  "version": "0.1.0-alpha.0",
  "description": "Browser environment Layers for Wardic — rAF clock, DOM renderer, input, probe, interpolators.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null
  },
  "scripts": {
    "build": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck:tests": "../../node_modules/typescript-7/bin/tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@wardic/core": "workspace:*",
    "culori": "^4.0.2"
  },
  "peerDependencies": {
    "effect": "^4.0.5"
  },
  "devDependencies": {
    "@wardic/test": "workspace:*"
  }
}
