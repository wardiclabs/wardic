{
  "name": "@wardic/dom",
  "version": "1.0.0-rc.6",
  "description": "The browser environment for Wardic: its clock, renderer, input, probe and projection system, as Effect Layers.",
  "keywords": [
    "animation",
    "motion",
    "dom",
    "effect"
  ],
  "homepage": "https://wardic.dev",
  "bugs": "https://github.com/wardiclabs/wardic/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wardiclabs/wardic.git",
    "directory": "packages/dom"
  },
  "license": "MIT",
  "author": {
    "name": "The Wardic contributors",
    "email": "hello@wardic.dev",
    "url": "https://wardic.dev"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@wardic/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "@wardic/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./internal/*": null
  },
  "scripts": {
    "build": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck:tests": "../../node_modules/typescript-7/bin/tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@wardic/core": "workspace:*",
    "culori": "^4.0.2"
  },
  "peerDependencies": {
    "effect": "^4.1.1"
  },
  "devDependencies": {
    "@wardic/test": "workspace:*"
  }
}
