{
  "// note": "Test-only typecheck: includes test/ and bench/ alongside src/, no emit, not part of the build graph. Run via `bun run typecheck:tests`.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    // The node tier runs these tests under Node, and the Clock/microtask guard tests
    // use its timers (`setTimeout`, `queueMicrotask`). `src` stays host-free.
    "types": ["node"],
    "noEmit": true,
    "composite": false,
    "rootDir": "."
  },
  "include": ["src", "test", "bench"]
}
