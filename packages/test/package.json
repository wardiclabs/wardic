{
  "name": "@wardic/test",
  "version": "1.0.0-rc.9",
  "description": "Headless testing Layers for Wardic: a clock that replays the frames you give it, a renderer that records what it's asked to draw, and input you push, so animation code runs without a browser.",
  "keywords": [
    "animation",
    "testing",
    "effect"
  ],
  "homepage": "https://wardic.dev",
  "bugs": "https://github.com/wardiclabs/wardic/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wardiclabs/wardic.git",
    "directory": "packages/test"
  },
  "license": "MIT",
  "author": {
    "name": "The Wardic contributors",
    "email": "hello@wardic.dev",
    "url": "https://wardic.dev"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@wardic/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck:tests": "../../node_modules/typescript-7/bin/tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@wardic/core": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^4.1.1"
  }
}
