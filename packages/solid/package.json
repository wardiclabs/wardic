{
  "name": "@wardic/solid",
  "version": "1.1.0",
  "description": "Motion for React's API on Solid 1 and Solid 2: Wardic's elements, gestures, layout and presence animations.",
  "keywords": [
    "animation",
    "motion",
    "solid",
    "solidjs",
    "framer-motion",
    "layout-animation",
    "gestures"
  ],
  "homepage": "https://wardic.dev",
  "bugs": "https://github.com/wardiclabs/wardic/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wardiclabs/wardic.git",
    "directory": "packages/solid"
  },
  "license": "MIT",
  "author": {
    "name": "The Wardic contributors",
    "email": "hello@wardic.dev",
    "url": "https://wardic.dev"
  },
  "files": [
    "dist/solid",
    "dist/browser",
    "dist/server",
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@wardic/source": "./src/index.tsx",
      "types": "./dist/solid/index.d.ts",
      "solid": "./dist/solid/index.jsx",
      "browser": "./dist/browser/index.js",
      "worker": "./dist/server/index.js",
      "deno": "./dist/server/index.js",
      "node": "./dist/server/index.js",
      "default": "./dist/browser/index.js"
    },
    "./unstable/v2": {
      "@wardic/source": "./src/unstable/v2/index.tsx",
      "types": "./dist/solid/unstable/v2/index.d.ts",
      "solid": "./dist/solid/unstable/v2/index.jsx",
      "browser": "./dist/browser/unstable/v2/index.js",
      "worker": "./dist/server/unstable/v2/index.js",
      "deno": "./dist/server/unstable/v2/index.js",
      "node": "./dist/server/unstable/v2/index.js",
      "default": "./dist/browser/unstable/v2/index.js"
    }
  },
  "scripts": {
    "build": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck:tests": "../../node_modules/typescript-7/bin/tsc -p tsconfig.test.json && ../../node_modules/typescript-7/bin/tsc -p tsconfig.v2.json"
  },
  "dependencies": {
    "@solid-primitives/refs": "^1.1.3",
    "@wardic/core": "workspace:*",
    "@wardic/dom": "workspace:*",
    "csstype": "^3.1.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.21",
    "effect": "^4.1.4",
    "solid-js": "^1.9.13 || ^2.0.0-rc.21"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7",
    "@solidjs/babel-plugin": "2.0.0-rc.21",
    "@solidjs/diagnostics": "2.0.0-rc.21",
    "@solidjs/router": "1.0.1",
    "@solidjs/router-2": "npm:@solidjs/router@2.0.0-next.44",
    "@solidjs/web": "2.0.0-rc.21",
    "@types/babel__core": "^7.20.5",
    "@wardic/test": "workspace:*",
    "babel-preset-solid": "1.9.12",
    "effect": "4.1.4",
    "solid-js": "^1.9.18",
    "solid-js-2": "npm:solid-js@2.0.0-rc.21"
  }
}
