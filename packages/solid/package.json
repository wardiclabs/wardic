{
  "name": "@wardic/solid",
  "version": "0.1.0-alpha.0",
  "description": "Solid framework binding for Wardic.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./unstable/v2": "./src/unstable/v2/index.ts"
  },
  "scripts": {
    "build": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck": "../../node_modules/typescript-7/bin/tsc --build",
    "typecheck:tests": "../../node_modules/typescript-7/bin/tsc -p tsconfig.test.json && ../../node_modules/typescript-7/bin/tsc -p tsconfig.v2.json"
  },
  "dependencies": {
    "@solid-primitives/refs": "^1.1.3",
    "@wardic/core": "workspace:*",
    "@wardic/dom": "workspace:*",
    "csstype": "^3.1.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.18",
    "effect": "^4.0.5",
    "solid-js": "^1.9.13 || ^2.0.0-rc.18"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7",
    "@solidjs/babel-plugin": "2.0.0-rc.18",
    "@solidjs/web": "2.0.0-rc.18",
    "@types/babel__core": "^7.20.5",
    "@wardic/test": "workspace:*",
    "effect": "4.0.5",
    "solid-js": "^1.9.13",
    "solid-js-2": "npm:solid-js@2.0.0-rc.18"
  }
}
