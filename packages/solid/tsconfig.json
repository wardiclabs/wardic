{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    // `dist/solid/`: the JSX kept as JSX, for the `solid` export condition (#554).
    "outDir": "${configDir}/dist/solid"
  },
  "include": ["src"],
  "// exclude": "The Solid 1 binding is tsconfig.v1.build.json's (#566): it compiles against Solid 1.",
  "exclude": ["src/v1"],
  "references": [{ "path": "../core" }, { "path": "../dom" }]
}
