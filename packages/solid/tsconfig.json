{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    // `dist/solid/`: the JSX kept as JSX, for the `solid` export condition (#554).
    "outDir": "${configDir}/dist/solid"
  },
  "include": ["src"],
  "// exclude": "The Solid 2 binding is tsconfig.v2.json's (#209): it compiles against Solid 2.",
  "exclude": ["src/unstable"],
  "references": [{ "path": "../core" }, { "path": "../dom" }]
}
