{
  "// note": "Test-only typecheck: includes test/ and bench/ alongside src/, no emit, not part of the build graph. Run via `bun run typecheck:tests`. bench:motion's Motion page is left out: React and framer-motion install only in bench/motion/react/ (#615).",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "composite": false,
    "rootDir": ".",
    // Solid 1 for every importer, as tsconfig.json maps it (#566).
    "paths": {
      "solid-js": ["./node_modules/solid-js-1/types/index.d.ts"],
      "solid-js/web": ["./node_modules/solid-js-1/web/types/index.d.ts"],
      "solid-js/store": ["./node_modules/solid-js-1/store/types/index.d.ts"],
      "solid-js/jsx-runtime": ["./node_modules/solid-js-1/types/jsx.d.ts"],
      "@solidjs/router": ["./node_modules/@solidjs/router-1/dist/index.d.ts"]
    }
  },
  "include": ["src", "test", "bench", "babel-modules.d.ts"],
  "exclude": ["src/unstable", "test/v2", "bench/page-v2.tsx", "bench/motion/wardic-v2-page.tsx", "bench/motion/motion-page.ts", "bench/motion/react"]
}
