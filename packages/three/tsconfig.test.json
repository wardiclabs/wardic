{
  "// note": "Test-only typecheck: includes test/ and bench/ alongside src/, no emit, not part of the build graph. Run via `bun run typecheck:tests`. Its root is the repo's: the bench runs on bench:core's driver (packages/core/bench, #883's PR 5b).",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // The node tier runs these tests under Node, with its timers; `src`'s scene input is the DOM's (#883's PR 5a).
    "types": ["node"],
    "noEmit": true,
    "composite": false,
    "rootDir": "../..",
    // `@wardic/three/solid`'s tests (#885): Solid 2's JSX, and Solid as packages/solid has it, as the
    // scene lab's typecheck maps it; `@wardic/solid` as its built declarations (`tsconfig.json`'s note).
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "paths": {
      "@wardic/solid": ["../solid/dist/solid/index.d.ts"],
      "solid-js": ["../solid/node_modules/solid-js/types/index.d.ts"],
      "@solidjs/web": ["../solid/node_modules/@solidjs/web/types/index.d.ts"],
      "@solidjs/web/jsx-runtime": ["../solid/node_modules/@solidjs/web/types/jsx.d.ts"],
      "@solidjs/web/jsx-dev-runtime": ["../solid/node_modules/@solidjs/web/types/jsx.d.ts"]
    }
  },
  // Solid's Babel plugins' types, for vite.solid2.ts, whose compile bench:three runs (#885's PR 6).
  "include": ["src", "test", "bench", "../solid/babel-modules.d.ts"]
}
