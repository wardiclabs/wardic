{
  "name": "@wardic/site",
  "private": true,
  "type": "module",
  "description": "Wardic's docs site, at wardic.dev (#558): SolidStart on Solid 2, MDX pages, prerendered.",
  "scripts": {
    "dev": "node scripts/reference.ts && vite",
    "build": "node scripts/reference.ts && vite build && node scripts/prerender.ts",
    "reference": "node scripts/reference.ts",
    "preview": "vite preview",
    "smoke:dev": "node scripts/reference.ts && bun scripts/smoke.ts",
    "typecheck": "../node_modules/typescript-7/bin/tsc --noEmit && ../node_modules/typescript-7/bin/tsc --noEmit -p samples/tsconfig.solid2.json && ../node_modules/typescript-7/bin/tsc --noEmit -p samples/tsconfig.solid1.json && ../node_modules/typescript-7/bin/tsc --noEmit -p samples/tsconfig.motion.json"
  },
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.4",
    "@solidjs/router": "2.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.20",
    "@wardic/core": "workspace:*",
    "@wardic/dom": "workspace:*",
    "@wardic/example-storefront-shared": "workspace:*",
    "@wardic/solid": "workspace:*",
    "effect": "4.1.1",
    "shiki": "4.3.1",
    "solid-js": "2.0.0-rc.20"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@shikijs/rehype": "4.3.1",
    "@solidjs/diagnostics": "2.0.0-rc.20",
    "@solidjs/vite-plugin": "3.0.0-next.54",
    "@types/react": "19.3.0",
    "filesystem-routing": "0.4.0",
    "hast-util-to-html": "9.0.5",
    "motion": "14.6.0",
    "pagefind": "1.6.0",
    "react": "19.3.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-plugin-missing-exports": "4.1.4",
    "vite": "8.3.4"
  }
}
