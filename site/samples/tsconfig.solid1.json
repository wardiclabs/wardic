{
  "// note": "The docs' Solid 1 samples (#558), typechecked against Solid 1 and @wardic/solid's root entry: every importer's `solid-js` mapped to Solid 1, which @wardic/solid's own package holds as `solid-js-1` (#566), as the site's app maps it to Solid 2.",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["@wardic/source"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "solid-js": ["../../packages/solid/node_modules/solid-js-1/types/index.d.ts"],
      "solid-js/web": ["../../packages/solid/node_modules/solid-js-1/web/types/index.d.ts"],
      "solid-js/store": ["../../packages/solid/node_modules/solid-js-1/store/types/index.d.ts"],
      "solid-js/jsx-runtime": ["../../packages/solid/node_modules/solid-js-1/types/jsx.d.ts"],
      "~/lib/wardic.ts": ["./solid1-wardic.ts"],
      // A Solid 1 sample still imports `@wardic/solid`, Solid 1's entry in the published 1.x the site documents:
      // since 2.0 that's `@wardic/solid/v1` (#566), where #566's docs PR moves them, and this goes.
      "@wardic/solid": ["../../packages/solid/src/v1/index.tsx"]
    }
  },
  "include": ["*/solid1.tsx"]
}
