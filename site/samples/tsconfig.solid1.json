{
  "// note": "The docs' Solid 1 samples (#558), typechecked against Solid 1 and @wardic/solid's root entry: every importer's `solid-js` mapped to Solid 1, which @wardic/solid's own package holds, as the site's app maps it to Solid 2.",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["@wardic/source"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "solid-js": ["../../packages/solid/node_modules/solid-js/types/index.d.ts"],
      "solid-js/web": ["../../packages/solid/node_modules/solid-js/web/types/index.d.ts"],
      "solid-js/store": ["../../packages/solid/node_modules/solid-js/store/types/index.d.ts"],
      "solid-js/jsx-runtime": ["../../packages/solid/node_modules/solid-js/types/jsx.d.ts"]
    }
  },
  "include": ["*/solid1.tsx"]
}
