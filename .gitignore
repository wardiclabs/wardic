
# Nix/direnv local cache
.direnv/
.envrc

# Dependencies & build output
node_modules/
dist/
*.tsbuildinfo

# Local reference material (vendored upstream source, not committed)
.reference/

# Tooling scratch space
.tmp/

# SolidStart / vinxi / Nitro build output (examples)
.vinxi/
.output/
.nitro/

# Vitest browser-mode failure screenshots (test artifacts, not source)
**/__screenshots__/
# Vitest 5's artifact root (failure screenshots, attachments, reports)
.vitest/

# Logs & OS cruft
*.log
.DS_Store

# The storefront showcase's smoke screenshots (#296).
.smoke/

# The storefront's Next.js app (#366): its build, and the types file `next typegen` writes.
.next/
next-env.d.ts

# Each package's copy of the root's licence files, made by `bun run build` (#554).
packages/*/LICENSE
packages/*/THIRD_PARTY_NOTICES.md

# The OpenAgents Control plugin's starter context and its config (#555): a contributor's own tooling,
# none of it about Wardic. Kept on disk, not in the repo.
.claude/context/
.claude/.context-manifest.json
.oac.json
